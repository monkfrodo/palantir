<UserControl x:Class="Palantir.Views.WallpaperCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="204" Height="180" Margin="8">

    <UserControl.Resources>
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#33FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border x:Name="RootBorder" CornerRadius="8" Background="#2D2D2D"
            BorderThickness="2" BorderBrush="Transparent" ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="120"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Thumbnail area -->
            <Grid Grid.Row="0" ClipToBounds="True">
                <!-- Thumbnail image -->
                <Border Background="#252525" CornerRadius="6,6,0,0">
                    <Image x:Name="ThumbnailImage" Stretch="UniformToFill"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                </Border>

                <!-- Loading indicator -->
                <TextBlock x:Name="LoadingText" Text="Loading..."
                           Foreground="#666666" FontSize="11"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>

                <!-- Active badges (top-right) -->
                <StackPanel x:Name="BadgesPanel" Orientation="Horizontal"
                            HorizontalAlignment="Right" VerticalAlignment="Top"
                            Margin="0,6,6,0">
                    <Border x:Name="DesktopBadge" Background="#4CAF50" CornerRadius="3"
                            Padding="4,2" Margin="0,0,3,0" Visibility="Collapsed">
                        <TextBlock Text="&#xE7F4;" FontFamily="Segoe MDL2 Assets"
                                   Foreground="White" FontSize="9"/>
                    </Border>
                    <Border x:Name="LockBadge" Background="#42A5F5" CornerRadius="3"
                            Padding="4,2" Visibility="Collapsed">
                        <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets"
                                   Foreground="White" FontSize="9"/>
                    </Border>
                </StackPanel>

                <!-- Hover overlay -->
                <Border x:Name="HoverOverlay" Background="#80000000"
                        Visibility="Collapsed" CornerRadius="6,6,0,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                                VerticalAlignment="Center" Margin="0">
                        <Button x:Name="BothButton" Click="BothButton_Click"
                                Style="{StaticResource ActionButtonStyle}">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="&#xE768;" FontFamily="Segoe MDL2 Assets"
                                           FontSize="16" HorizontalAlignment="Center" Foreground="White"/>
                                <TextBlock Text="Both" FontSize="10" HorizontalAlignment="Center"
                                           Foreground="White" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="DesktopButton" Click="DesktopButton_Click"
                                Style="{StaticResource ActionButtonStyle}" Margin="8,0">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="&#xE7F4;" FontFamily="Segoe MDL2 Assets"
                                           FontSize="16" HorizontalAlignment="Center" Foreground="White"/>
                                <TextBlock Text="Desktop" FontSize="10" HorizontalAlignment="Center"
                                           Foreground="White" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="LockButton" Click="LockButton_Click"
                                Style="{StaticResource ActionButtonStyle}">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets"
                                           FontSize="16" HorizontalAlignment="Center" Foreground="White"/>
                                <TextBlock Text="Lock" FontSize="10" HorizontalAlignment="Center"
                                           Foreground="White" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Info area -->
            <StackPanel Grid.Row="1" Margin="8,6,8,4" VerticalAlignment="Center">
                <TextBlock x:Name="NameText" Foreground="#E0E0E0" FontSize="12"
                           FontWeight="Medium" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="InfoText" Foreground="#808080" FontSize="10"
                           Margin="0,2,0,0"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
