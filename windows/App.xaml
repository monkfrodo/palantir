<Application x:Class="Palantir.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <!-- Dark theme colors -->
            <SolidColorBrush x:Key="BackgroundBrush" Color="#1E1E1E"/>
            <SolidColorBrush x:Key="SurfaceBrush" Color="#2D2D2D"/>
            <SolidColorBrush x:Key="CardBrush" Color="#353535"/>
            <SolidColorBrush x:Key="BorderBrush" Color="#404040"/>
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="#E0E0E0"/>
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="#A0A0A0"/>
            <SolidColorBrush x:Key="AccentBrush" Color="#4FC3F7"/>
            <SolidColorBrush x:Key="DesktopActiveBrush" Color="#4CAF50"/>
            <SolidColorBrush x:Key="LockActiveBrush" Color="#42A5F5"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
